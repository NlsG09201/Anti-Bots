# Application
APP_NAME=StreamShield
APP_ENV=development
# production = enforces secure cookies, hides /docs, validates secrets
APP_DEBUG=false
APP_SECRET_KEY=change-me-to-64-char-random-secret-key-for-production-use-only
APP_API_VERSION=v1
APP_HOST=0.0.0.0
APP_PORT=8000
APP_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
APP_FRONTEND_URL=http://localhost:3000

# Database
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=streamshield
POSTGRES_PASSWORD=streamshield_secure_password
POSTGRES_DB=streamshield
DATABASE_URL=postgresql+asyncpg://streamshield:streamshield_secure_password@postgres:5432/streamshield

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=redis_secure_password
REDIS_URL=redis://:redis_secure_password@redis:6379/0

# RabbitMQ
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=streamshield
RABBITMQ_PASSWORD=rabbitmq_secure_password
CELERY_BROKER_URL=amqp://streamshield:rabbitmq_secure_password@rabbitmq:5672//
CELERY_RESULT_BACKEND=redis://:redis_secure_password@redis:6379/1

# JWT
JWT_SECRET_KEY=change-me-jwt-secret-key-min-32-chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Encryption
AES_ENCRYPTION_KEY=change-me-32-byte-aes-key-here!!

# Twitch
TWITCH_CLIENT_ID=afu46q601sn7xfukiskqrgvz2nkjqw
TWITCH_CLIENT_SECRET=afu46q601sn7xfukiskqrgvz2nkjqw
# Debe apuntar al CALLBACK del backend (no al frontend)
TWITCH_REDIRECT_URI=http://localhost:8000/api/v1/integrations/twitch/callback
TWITCH_WEBHOOK_SECRET=
TWITCH_EVENTSUB_CALLBACK_URL=https://your-domain.com/api/v1/webhooks/twitch

# --- Kick (opcional; plataforma futura) ---
# https://kick.com/settings/developer — OAuth para canales Kick
KICK_CLIENT_ID=01KS1MT7A3D29Z9V8NHG7TCNNM
KICK_CLIENT_SECRET=641492ded90a6a96e02b356634b51d259ee4743829cc1fbbba7a468a1d982714641492ded90a6a96e02b356634b51d259ee4743829cc1fbbba7a468a1d982714
KICK_REDIRECT_URI=http://localhost:3000/auth/kick/callback

# --- YouTube Live (opcional) ---
# OAuth: https://console.cloud.google.com/apis/credentials (app web, redirect URI abajo)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://localhost:3000/auth/youtube/callback
# API Key (solo lectura): misma consola → Credenciales → Clave API → YouTube Data API v3 activada
YOUTUBE_API_KEY=

# --- TikTok Live (monitoreo SOC en tiempo real) ---
# Opcional: cookie sessionid si TikTok limita conexiones sin sesión
TIKTOK_SESSION_ID=
PLATFORM_MONITOR_ENABLED=true
PLATFORM_MONITOR_RUN_IN_API=true
PLATFORM_MONITOR_WORKER=false
PLATFORM_MONITOR_POLL_SECONDS=30
PLATFORM_MONITOR_MAX_STREAMS=12

# --- Discord alertas (opcional) ---
# Canal → Integraciones → Webhooks → Nueva → copiar URL
DISCORD_WEBHOOK_URL=

# --- Cloudflare WAF (opcional; bloqueo automático de IPs de alto riesgo) ---
# https://dash.cloudflare.com/profile/api-tokens → Edit zone WAF + Zone ID en Overview del dominio
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=

# --- Threat Intelligence (VPN, proxy, TOR, datacenter, residential, botnets) ---
# AbuseIPDB: https://www.abuseipdb.com/account/api (1000 req/día gratis)
ABUSEIPDB_API_KEY=
# IPQualityScore: https://www.ipqualityscore.com/create-account (proxy/VPN/residential/bot)
IPQUALITYSCORE_API_KEY=
# VirusTotal: https://www.virustotal.com/gui/join-us
VIRUSTOTAL_API_KEY=
# MaxMind GeoLite2: https://www.maxmind.com/en/geolite2/signup
MAXMIND_LICENSE_KEY=
# Fallback geolocalización + ASN (45 req/min sin clave)
THREAT_INTEL_IPAPI_ENABLED=true
THREAT_INTEL_CACHE_TTL_SECONDS=3600
THREAT_INTEL_CACHE_TTL_HIGH_RISK=7200
THREAT_INTEL_BLOCK_THRESHOLD=85

# GeoIP (MaxMind .mmdb en disco)
GEOIP_DATABASE_PATH=/app/data/GeoLite2-City.mmdb
GEOIP_ASN_DATABASE_PATH=/app/data/GeoLite2-ASN.mmdb

# --- Event pipeline (Redis Streams + arq/BullMQ + WebSocket pub/sub) ---
EVENT_PIPELINE_ENABLED=true
EVENT_PIPELINE_SYNC_FALLBACK=false
EVENT_QUEUE_ENABLED=true
EVENT_STREAM_MAX_LEN=200000
EVENT_CONSUMER_BATCH_SIZE=100
EVENT_CONSUMER_BLOCK_MS=2000
EVENT_REALTIME_PUBSUB_ENABLED=true
EVENT_QUEUE_MAX_JOBS=500
EVENT_QUEUE_JOB_TIMEOUT_SECONDS=120
# Worker separado: arq app.workers.arq_worker.WorkerSettings

# Twitch Insights viewbot database (https://twitchinsights.net/bots)
TWITCH_INSIGHTS_ENABLED=true
TWITCH_INSIGHTS_CACHE_HOURS=6

# TwitchBots.info — directorio publico de bots (https://api.twitchbots.info/v2/)
TWITCHBOTS_INFO_ENABLED=true
TWITCHBOTS_INFO_BASE_URL=https://api.twitchbots.info/v2
TWITCHBOTS_INFO_VERIFY_ON_INGEST=true
TWITCHBOTS_INFO_QUEUE_ENABLED=true
TWITCHBOTS_INFO_KNOWN_BOT_RISK_SCORE=94
TWITCHBOTS_INFO_CACHE_TTL_HIT=604800
TWITCHBOTS_INFO_CACHE_TTL_MISS=3600
TWITCHBOTS_INFO_USERNAME_CACHE_TTL=86400
TWITCHBOTS_INFO_RATE_LIMIT_RPS=8
TWITCHBOTS_INFO_BATCH_SIZE=100
TWITCHBOTS_INFO_REQUEST_TIMEOUT=12
TWITCHBOTS_INFO_MAX_RETRIES=3
TWITCHBOTS_INFO_CACHE_WARM_ON_STARTUP=true

# Salud monitores Kick / YouTube / TikTok (heartbeat, APIs, alertas SOC)
PLATFORM_HEALTH_ENABLED=true
PLATFORM_HEALTH_AUDIT_SECONDS=45
PLATFORM_HEALTH_WORKER_HEARTBEAT_TTL=90
PLATFORM_HEALTH_ALERT_COOLDOWN_SECONDS=600

# Viewer Flow Intelligence (Kick / YouTube / TikTok)
VIEWER_FLOW_ENABLED=true
VIEWER_FLOW_FLUSH_SECONDS=30
VIEWER_FLOW_WINDOW_SECONDS=120
AUTO_TWITCH_BAN_ENABLED=true
BOT_SUSPECTED_ATTACK_THRESHOLD=5
BACKGROUND_ATTACK_SCAN_INTERVAL=3

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
# En Vercel: dejar NEXT_PUBLIC_API_URL vacío (proxy /api) y usar DIRECT para IRC largo:
# NEXT_PUBLIC_API_DIRECT_URL=https://anti-bots.onrender.com
NEXT_PUBLIC_API_DIRECT_URL=
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# IRC al cargar listado de chatters (segundos; default 35)
VIEWER_LOAD_IRC_SECONDS=35

# Detección inteligente de viewbots en tiempo real
VIEWBOT_REALTIME_ENABLED=true
VIEWBOT_WINDOW_SECONDS=120
VIEWBOT_ALERT_THRESHOLD=50
VIEWBOT_AUTO_BLOCK_THRESHOLD=85
VIEWBOT_ML_ENABLED=true

# AI Intelligence (anomaly detection, viewbot/raid prediction, adaptive learning)
AI_INTEL_ENABLED=true
AI_INTEL_AUTO_MITIGATE=false
AI_INTEL_EARLY_WARNING_THRESHOLD=0.65
AI_MODEL_PATH=data/ai_models
# Optional: archive feature vectors for retraining (OLTP remains PostgreSQL)
MONGODB_URI=mongodb+srv://nelsondavid1954:Nelson09092001@cluster0.21qruo8.mongodb.net/?appName=Cluster0
# Global threat intelligence (entities, engagement, graphs, cross-platform)
THREAT_INTEL_ENGINE_ENABLED=true

# Live Stream Intelligence Monitor (competitive external streams)
LIVE_INTEL_ENABLED=true
LIVE_INTEL_SAMPLE_SECONDS=20
LIVE_INTEL_MAX_STREAMS=30

# Weka J48 bot classifier (viewer sessions → bot/human)
WEKA_J48_ENABLED=true
WEKA_J48_PREFER_WEKA=true
WEKA_PYTHON_ENABLED=true
WEKA_JVM_EAGER_START=true
WEKA_JVM_MAX_HEAP=512m
WEKA_J48_MODEL_PATH=data/weka_models
# Java 11+ (Docker incluye OpenJDK 21). En Windows: Temurin 17 o 21 y opcionalmente:
# WEKA_JAVA_HOME=C:\Program Files\Eclipse Adoptium\jdk-21.x.x-hotspot
WEKA_JAVA_HOME=
WEKA_J48_MIN_TRAINING_SAMPLES=50
VIEWBOT_ML_ENABLED=true

# Monitoring
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
PROMETHEUS_ENABLED=true

# Fingerprinting avanzado (canvas, WebRTC, UA, automatización, correlación de sesiones)
# El widget v2 carga streamshield-fp.js; API: POST /api/v1/detection/fingerprint/advanced

# Security (OWASP / defense in depth)
RATE_LIMIT_PER_MINUTE=100
RATE_LIMIT_BURST=20
SECURITY_TRUST_PROXY_HEADERS=true
SECURITY_RATE_LIMIT_ENABLED=true
SECURITY_GLOBAL_IP_LIMIT_PER_MINUTE=400
SECURITY_BLOCK_EMPTY_UA=true
SECURITY_BLOCK_SPOOFED_IP=true
SECURITY_BLOCK_AUTOMATION=false
SECURITY_REPLAY_PROTECTION_ENABLED=true
SECURITY_REPLAY_STRICT=false
SECURITY_REPLAY_MAX_SKEW_SECONDS=120
SECURITY_WIDGET_HMAC_ENABLED=false
SECURITY_BLOCKED_COUNTRIES=
SECURITY_BLOCKED_ASN_KEYWORDS=HOSTING,DATACENTER,AMAZON,GOOGLE,DIGITALOCEAN
FAIL2BAN_MAX_ATTEMPTS=5
FAIL2BAN_WINDOW_SECONDS=300
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
TRUSTED_HOSTS=localhost,127.0.0.1,tu-dominio.com,api.tu-dominio.com

# Cloudflare auto-block (optional)
CLOUDFLARE_AUTO_BLOCK=false
CLOUDFLARE_BLOCK_RISK_THRESHOLD=85.0
