# Application
APP_NAME=StreamShield
APP_ENV=development
# production = enforces secure cookies, hides /docs, validates secrets
APP_DEBUG=false
APP_SECRET_KEY=change-me-to-64-char-random-secret-key-for-production-use-only
APP_API_VERSION=v1
APP_HOST=0.0.0.0
APP_PORT=8000
APP_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
APP_FRONTEND_URL=http://localhost:3000

# Database
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=streamshield
POSTGRES_PASSWORD=streamshield_secure_password
POSTGRES_DB=streamshield
DATABASE_URL=postgresql+asyncpg://streamshield:streamshield_secure_password@postgres:5432/streamshield

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=redis_secure_password
REDIS_URL=redis://:redis_secure_password@redis:6379/0

# RabbitMQ
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=streamshield
RABBITMQ_PASSWORD=rabbitmq_secure_password
CELERY_BROKER_URL=amqp://streamshield:rabbitmq_secure_password@rabbitmq:5672//
CELERY_RESULT_BACKEND=redis://:redis_secure_password@redis:6379/1

# JWT
JWT_SECRET_KEY=change-me-jwt-secret-key-min-32-chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Encryption
AES_ENCRYPTION_KEY=change-me-32-byte-aes-key-here!!

# Twitch
TWITCH_CLIENT_ID=afu46q601sn7xfukiskqrgvz2nkjqw
TWITCH_CLIENT_SECRET=afu46q601sn7xfukiskqrgvz2nkjqw
# Debe apuntar al CALLBACK del backend (no al frontend)
TWITCH_REDIRECT_URI=http://localhost:8000/api/v1/integrations/twitch/callback
TWITCH_WEBHOOK_SECRET=
TWITCH_EVENTSUB_CALLBACK_URL=https://your-domain.com/api/v1/webhooks/twitch

# --- Kick (opcional; plataforma futura) ---
# https://kick.com/settings/developer — OAuth para canales Kick
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=
KICK_REDIRECT_URI=http://localhost:3000/auth/kick/callback

# --- YouTube Live (opcional) ---
# OAuth: https://console.cloud.google.com/apis/credentials (app web, redirect URI abajo)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://localhost:3000/auth/youtube/callback
# API Key (solo lectura): misma consola → Credenciales → Clave API → YouTube Data API v3 activada
YOUTUBE_API_KEY=

# --- Discord alertas (opcional) ---
# Canal → Integraciones → Webhooks → Nueva → copiar URL
DISCORD_WEBHOOK_URL=

# --- Cloudflare WAF (opcional; bloqueo automático de IPs de alto riesgo) ---
# https://dash.cloudflare.com/profile/api-tokens → Edit zone WAF + Zone ID en Overview del dominio
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=

# --- Threat Intelligence (opcional; mejora detección proxy/VPN/TOR) ---
# AbuseIPDB: https://www.abuseipdb.com/account/api (1000 req/día gratis)
ABUSEIPDB_API_KEY=
# IPQualityScore: https://www.ipqualityscore.com/create-account
IPQUALITYSCORE_API_KEY=
# VirusTotal: https://www.virustotal.com/gui/join-us
VIRUSTOTAL_API_KEY=
# MaxMind GeoLite2: https://www.maxmind.com/en/geolite2/signup (para descargar GeoIP)
MAXMIND_LICENSE_KEY=

# GeoIP
GEOIP_DATABASE_PATH=/app/data/GeoLite2-City.mmdb

# Twitch Insights viewbot database (https://twitchinsights.net/bots)
TWITCH_INSIGHTS_ENABLED=true
TWITCH_INSIGHTS_CACHE_HOURS=6
AUTO_TWITCH_BAN_ENABLED=true
BOT_SUSPECTED_ATTACK_THRESHOLD=5
BACKGROUND_ATTACK_SCAN_INTERVAL=3

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# Monitoring
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
PROMETHEUS_ENABLED=true

# Security
RATE_LIMIT_PER_MINUTE=100
RATE_LIMIT_BURST=20
FAIL2BAN_MAX_ATTEMPTS=5
FAIL2BAN_WINDOW_SECONDS=300
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
TRUSTED_HOSTS=localhost,127.0.0.1,tu-dominio.com,api.tu-dominio.com

# Cloudflare auto-block (optional)
CLOUDFLARE_AUTO_BLOCK=false
CLOUDFLARE_BLOCK_RISK_THRESHOLD=85.0
