# Local-only configuration for docker-compose.enterprise.yml.
# Copy to deploy/enterprise/.env. Never put production credentials here.
APP_ENV=development
APP_DEBUG=true
APP_SECRET_KEY=local-development-app-secret-change-before-any-public-use
JWT_SECRET_KEY=local-development-jwt-secret-change-before-any-public-use
AES_ENCRYPTION_KEY=local-development-aes-secret-change-before-any-public-use
APP_CORS_ORIGINS=http://localhost:3000
APP_FRONTEND_URL=http://localhost:3000
OPENAI_API_KEY=
DISCORD_WEBHOOK_URL=
ALERT_WEBHOOK_URLS=
