# Copia a Render → Environment → Add from .env
# Sustituye los valores YOUR_* por los de deploy/render.env (local)

DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST.neon.tech/Anti-Bot?sslmode=require
APP_SECRET_KEY=YOUR_APP_SECRET_32_CHARS_MIN
JWT_SECRET_KEY=YOUR_JWT_SECRET_32_CHARS_MIN
AES_ENCRYPTION_KEY=YOUR_AES_KEY_32_CHARS

TWITCH_CLIENT_ID=YOUR_TWITCH_CLIENT_ID
TWITCH_CLIENT_SECRET=YOUR_TWITCH_CLIENT_SECRET
TWITCH_REDIRECT_URI=https://anti-bots.onrender.com/api/v1/integrations/twitch/callback
TWITCH_WEBHOOK_SECRET=YOUR_TWITCH_WEBHOOK_SECRET
TWITCH_EVENTSUB_CALLBACK_URL=https://anti-bots.onrender.com/api/v1/webhooks/twitch

KICK_CLIENT_ID=YOUR_KICK_CLIENT_ID
KICK_CLIENT_SECRET=YOUR_KICK_CLIENT_SECRET
KICK_REDIRECT_URI=https://anti-bots.onrender.com/api/v1/integrations/kick/callback

YOUTUBE_CLIENT_ID=YOUR_YOUTUBE_CLIENT_ID
YOUTUBE_CLIENT_SECRET=YOUR_YOUTUBE_CLIENT_SECRET
YOUTUBE_REDIRECT_URI=https://anti-bots.onrender.com/api/v1/integrations/youtube/callback
YOUTUBE_API_KEY=YOUR_YOUTUBE_API_KEY
