# Copia a Render → Environment → Add from .env
# Sustituye los valores YOUR_* por los de deploy/render.env (local)

DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST.neon.tech/Anti-Bot?sslmode=require
APP_SECRET_KEY=YOUR_APP_SECRET_32_CHARS_MIN
JWT_SECRET_KEY=YOUR_JWT_SECRET_32_CHARS_MIN
AES_ENCRYPTION_KEY=YOUR_AES_KEY_32_CHARS
