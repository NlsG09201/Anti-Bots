# Vercel -> Settings -> Environment Variables -> Production
# Generar con: deploy\vercel-conectar.ps1 -ApiUrl "https://tu-api.com"

# Reenvia /api/* del frontend al backend (obligatorio)
API_PROXY_TARGET=https://api.tudominio.com

# WebSocket directo al backend (obligatorio para dashboard en vivo)
NEXT_PUBLIC_WS_URL=wss://api.tudominio.com

# NO definir en Production (deja que use proxy same-origin):
# NEXT_PUBLIC_API_URL=http://localhost:8000
