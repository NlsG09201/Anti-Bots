# Copy to .env.staging and set real staging-only values; never reuse production secrets.
API_DOMAIN=staging-api.example.com
APP_ENV_FILE=.env.staging
APP_ENV=staging
APP_DEBUG=false
APP_SECRET_KEY=replace-with-a-unique-random-secret-of-at-least-32-characters
JWT_SECRET_KEY=replace-with-a-different-random-secret-of-at-least-32-characters
AES_ENCRYPTION_KEY=replace-with-a-unique-32-byte-encryption-key
APP_CORS_ORIGINS=https://staging.example.com
APP_FRONTEND_URL=https://staging.example.com
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@STAGING_DATABASE_HOST/DATABASE?sslmode=require
REDIS_URL=redis://redis:6379/0
COOKIE_SECURE=true
COOKIE_SAMESITE=none
TRUSTED_HOSTS=staging-api.example.com
API_MEMORY_LIMIT=2G
