# Copiar a .env en el VPS: cp env.example .env && nano .env
# Dominio público de la API (DNS A/AAAA debe apuntar a la IP del VPS)
API_DOMAIN=api.tudominio.com

APP_NAME=StreamShield
APP_ENV=production
APP_DEBUG=false
APP_SECRET_KEY=genera-un-secreto-aleatorio-min-32-caracteres
APP_API_VERSION=v1
APP_HOST=0.0.0.0
APP_PORT=8000
APP_CORS_ORIGINS=https://anti-bots.vercel.app
APP_FRONTEND_URL=https://anti-bots.vercel.app

# Neon (misma URL que en Render; en Neon Console permite la IP del VPS si usas restricción)
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST/ANTI-BOT?sslmode=require

JWT_SECRET_KEY=genera-otro-secreto-min-32-chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

AES_ENCRYPTION_KEY=clave-aes-exactamente-32-bytes!!

TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_REDIRECT_URI=https://api.tudominio.com/api/v1/integrations/twitch/callback
TWITCH_WEBHOOK_SECRET=
TWITCH_EVENTSUB_CALLBACK_URL=https://api.tudominio.com/api/v1/webhooks/twitch

COOKIE_SECURE=true
COOKIE_SAMESITE=none
TRUSTED_HOSTS=api.tudominio.com,tudominio.com,localhost,127.0.0.1

# Opcional — con perfil redis: docker compose --profile redis up -d
# REDIS_URL=redis://redis:6379/0

RATE_LIMIT_PER_MINUTE=100
RATE_LIMIT_BURST=20
FAIL2BAN_MAX_ATTEMPTS=5
FAIL2BAN_WINDOW_SECONDS=300
