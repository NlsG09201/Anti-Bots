# Copia las líneas que necesites a Render → Environment (o al Secret File).
# Todas son opcionales; sin ellas StreamShield funciona solo con Twitch.
#
# LISTADO DE VIEWERS EN CHAT (obligatorio para listado completo):
# - Tu canal: Dashboard → Settings → Conectar Twitch (scope moderator:read:chatters)
# - Canal ajeno: botón "Invitar streamer" en esta página
# - Vercel: NEXT_PUBLIC_API_DIRECT_URL=https://anti-bots.onrender.com (evita timeout 502 en IRC)

# YouTube Live
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=https://anti-bots.vercel.app/auth/youtube/callback
YOUTUBE_API_KEY=

# Kick
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=
KICK_REDIRECT_URI=https://anti-bots.vercel.app/auth/kick/callback

# Alertas SOC en Discord
DISCORD_WEBHOOK_URL=

# Cloudflare (requiere CLOUDFLARE_AUTO_BLOCK=true en .env)
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_AUTO_BLOCK=false
CLOUDFLARE_BLOCK_RISK_THRESHOLD=85.0

# Threat intelligence (reputación IP en viewers/ataques)
ABUSEIPDB_API_KEY=
IPQUALITYSCORE_API_KEY=
VIRUSTOTAL_API_KEY=
MAXMIND_LICENSE_KEY=
