table dim_date

    column date_key
        dataType: int64
        isKey
        sourceColumn: date_key
        summarizeBy: none

    column full_date
        dataType: dateTime
        isKey
        sourceColumn: full_date
        summarizeBy: none

    column year
        dataType: int64
        sourceColumn: year
        summarizeBy: none

    column quarter
        dataType: int64
        sourceColumn: quarter
        summarizeBy: none

    column month
        dataType: int64
        sourceColumn: month
        summarizeBy: none

    column month_name
        dataType: string
        sourceColumn: month_name
        summarizeBy: none

    column day_of_month
        dataType: int64
        sourceColumn: day_of_month
        summarizeBy: none

    column iso_week
        dataType: int64
        sourceColumn: iso_week
        summarizeBy: none

    column day_of_week
        dataType: int64
        sourceColumn: day_of_week
        summarizeBy: none

    partition dim_date = m
        mode: import
        source =
            let
                Source = PostgreSQL.Database(pServer, pDatabase),
                Warehouse = Source{[Schema = "bi", Item = "dim_date"]}[Data],
                SetTypes = Table.TransformColumnTypes(Warehouse, {
                    {"date_key", Int64.Type}, {"full_date", type date},
                    {"year", Int64.Type}, {"quarter", Int64.Type},
                    {"month", Int64.Type}, {"month_name", type text},
                    {"day_of_month", Int64.Type}, {"iso_week", Int64.Type},
                    {"day_of_week", Int64.Type}
                })
            in
                SetTypes
