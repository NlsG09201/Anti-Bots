table fact_chat_activity

    column tenant_id
        dataType: string
        sourceColumn: tenant_id
        summarizeBy: none

    column stream_id
        dataType: string
        sourceColumn: stream_id
        summarizeBy: none

    column platform_key
        dataType: string
        sourceColumn: platform_key
        summarizeBy: none

    column channel_name
        dataType: string
        sourceColumn: channel_name
        summarizeBy: none

    column activity_date
        dataType: dateTime
        sourceColumn: activity_date
        summarizeBy: none

    column event_type
        dataType: string
        sourceColumn: event_type
        summarizeBy: none

    column messages
        dataType: int64
        sourceColumn: messages
        summarizeBy: sum

    column unique_users
        dataType: int64
        sourceColumn: unique_users
        summarizeBy: sum

    column suspicious_messages
        dataType: int64
        sourceColumn: suspicious_messages
        summarizeBy: sum

    column average_risk_score
        dataType: double
        sourceColumn: average_risk_score
        summarizeBy: average

    measure 'Mensajes de chat' =
        CALCULATE(
            SUM(fact_chat_activity[messages]),
            fact_chat_activity[event_type] IN {"chat_message", "message"}
        )
        formatString: #,0

    partition fact_chat_activity = m
        mode: import
        source =
            let
                Source = PostgreSQL.Database(pServer, pDatabase),
                Warehouse = Source{[Schema = "bi", Item = "vw_powerbi_chat_activity"]}[Data],
                NormalizeEventType = Table.TransformColumns(Warehouse, {
                    {"event_type", each Text.Lower(Text.Trim(Text.From(_))), type text}
                }),
                FillNullMeasures = Table.ReplaceValue(NormalizeEventType, null, 0, Replacer.ReplaceValue, {
                    "messages", "unique_users", "suspicious_messages", "average_risk_score"
                }),
                SetTypes = Table.TransformColumnTypes(FillNullMeasures, {
                    {"tenant_id", type text}, {"stream_id", type text}, {"platform_key", type text},
                    {"channel_name", type text}, {"activity_date", type date},
                    {"event_type", type text}, {"messages", Int64.Type},
                    {"unique_users", Int64.Type}, {"suspicious_messages", Int64.Type},
                    {"average_risk_score", type number}
                })
            in
                SetTypes
