table dim_stream

    column stream_key
        dataType: int64
        sourceColumn: stream_key
        summarizeBy: none

    column stream_id
        dataType: string
        isKey
        sourceColumn: stream_id
        summarizeBy: none

    column tenant_id
        dataType: string
        sourceColumn: tenant_id
        summarizeBy: none

    column streamer_id
        dataType: string
        sourceColumn: streamer_id
        summarizeBy: none

    column platform_key
        dataType: string
        sourceColumn: platform_key
        summarizeBy: none

    column channel_name
        dataType: string
        sourceColumn: channel_name
        summarizeBy: none

    column created_at
        dataType: dateTime
        sourceColumn: created_at
        summarizeBy: none

    column updated_at
        dataType: dateTime
        sourceColumn: updated_at
        summarizeBy: none

    partition dim_stream = m
        mode: import
        source =
            let
                Source = PostgreSQL.Database(pServer, pDatabase),
                Warehouse = Source{[Schema = "bi", Item = "vw_powerbi_dim_stream"]}[Data],
                CleanText = Table.TransformColumns(Warehouse, {
                    {"channel_name", each Text.Trim(Text.Clean(Text.From(_))), type text}
                }),
                SetTypes = Table.TransformColumnTypes(CleanText, {
                    {"stream_key", Int64.Type}, {"stream_id", type text},
                    {"tenant_id", type text}, {"streamer_id", type text},
                    {"platform_key", type text}, {"created_at", type datetimezone},
                    {"updated_at", type datetimezone}
                })
            in
                SetTypes
