Viewers monitoreados = DISTINCTCOUNT(fact_viewer_session[session_id])

Viewers sospechosos = CALCULATE(
    DISTINCTCOUNT(fact_viewer_session[session_id]),
    fact_viewer_session[is_suspected_bot] = TRUE()
)

Porcentaje sospechoso = DIVIDE([Viewers sospechosos], [Viewers monitoreados], 0)

Ataques activos = CALCULATE(
    DISTINCTCOUNT(fact_attack[attack_id]),
    fact_attack[status] = "active"
)

Streams en vivo = CALCULATE(
    DISTINCTCOUNT(fact_stream_snapshot[stream_id]),
    fact_stream_snapshot[is_live] = TRUE(),
    fact_stream_snapshot[snapshot_date] = MAX(fact_stream_snapshot[snapshot_date])
)

Viewers en vivo = CALCULATE(
    SUM(fact_stream_snapshot[viewer_count]),
    fact_stream_snapshot[is_live] = TRUE(),
    fact_stream_snapshot[snapshot_date] = MAX(fact_stream_snapshot[snapshot_date])
)

Chatters activos = CALCULATE(
    SUM(fact_stream_snapshot[active_chatters]),
    fact_stream_snapshot[is_live] = TRUE(),
    fact_stream_snapshot[snapshot_date] = MAX(fact_stream_snapshot[snapshot_date])
)

Cobertura chat % = DIVIDE([Chatters activos], [Viewers en vivo], 0)

Mensajes de chat = CALCULATE(
    SUM(fact_chat_activity[messages]),
    fact_chat_activity[event_type] IN {"chat_message", "message"}
)

Riesgo promedio = AVERAGE(fact_stream_snapshot[threat_score])

Riesgo crítico = CALCULATE(
    DISTINCTCOUNT(fact_attack[attack_id]),
    fact_attack[severity] = "critical"
)

Duración media de sesión (min) = DIVIDE(
    AVERAGE(fact_viewer_session[watch_duration_seconds]), 60, 0
)
