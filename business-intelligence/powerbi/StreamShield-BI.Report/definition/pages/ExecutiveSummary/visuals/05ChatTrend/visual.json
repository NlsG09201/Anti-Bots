          ]
        },
        "Y": {
          "projections": [
            {
              "field": { "Measure": { "Expression": { "SourceRef": { "Entity": "fact_chat_activity" } }, "Property": "Mensajes de chat" } },
              "queryRef": "fact_chat_activity.Mensajes de chat"
            }
          ]
        }
      }
    },
    "drillFilterOtherVisuals": true
  }
}
