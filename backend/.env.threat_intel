"""Threat Intelligence System Configuration."""

# ============= THREAT INTELLIGENCE INTEGRATIONS =============

# IPInfo Configuration
IPINFO_API_KEY=${IPINFO_API_KEY:-}

# AbuseIPDB Configuration
ABUSEIPDB_API_KEY=${ABUSEIPDB_API_KEY:-}

# MaxMind GeoIP2 Databases
MAXMIND_CITY_DB_PATH=/data/GeoLite2-City.mmdb
MAXMIND_ASN_DB_PATH=/data/GeoLite2-ASN.mmdb

# IP2Location Database
IP2LOCATION_DB_PATH=/data/IP2LOCATION-LITE-DB5.CSV

# VirusTotal
VIRUSTOTAL_API_KEY=${VIRUSTOTAL_API_KEY:-}

# ============= FEATURE FLAGS =============

# Enable threat intelligence engine
THREAT_INTEL_ENGINE_ENABLED=true

# Enable AI intelligence system
AI_INTEL_ENABLED=true

# Enable TOR detection
TOR_DETECTION_ENABLED=true

# Enable Spamhaus checks
SPAMHAUS_ENABLED=true

# ============= ALERT CONFIGURATION =============

# Discord Webhook for alerts
DISCORD_WEBHOOK_URL=${DISCORD_WEBHOOK_URL:-}

# Custom webhook URLs (comma-separated)
ALERT_WEBHOOK_URLS=${ALERT_WEBHOOK_URLS:-}

# ============= CACHE CONFIGURATION =============

# Redis/Upstash
REDIS_URL=${REDIS_URL:-redis://localhost:6379}
CACHE_TTL=3600

# ============= DATABASE CONFIGURATION =============

# MongoDB Atlas for threat logs
MONGODB_URI=${MONGODB_URI:-mongodb+srv://user:pass@cluster.mongodb.net/streaming_threat_intel}
MONGODB_THREAT_COLLECTION=threat_assessments
MONGODB_ALERTS_COLLECTION=alerts

# ============= PERFORMANCE TUNING =============

# IP assessment timeout
IP_ASSESSMENT_TIMEOUT_SECONDS=10

# Behavioral analysis window size
BEHAVIORAL_WINDOW_SIZE=500

# Chat message window
CHAT_MESSAGE_WINDOW=500

# Max concurrent API requests
MAX_CONCURRENT_ASSESSMENTS=50

# ============= LOGGING =============

# Log level
LOG_LEVEL=${LOG_LEVEL:-INFO}

# Enable threat debug logs
THREAT_DEBUG_LOGS=false

# ============= MONITORING =============

# Prometheus metrics enabled
METRICS_ENABLED=true

# Metrics port
METRICS_PORT=9090
