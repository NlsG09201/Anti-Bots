FROM python:3.11-slim AS build-deps

WORKDIR /build

RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc libpq-dev \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install --prefix=/install -r requirements.txt

FROM python:3.11-slim AS runtime

WORKDIR /app

# scikit-learn's native extensions need the OpenMP runtime; the worker does not
# start Weka's JVM, so a Java runtime is intentionally omitted here.
RUN apt-get update && apt-get install -y --no-install-recommends \
    libgomp1 libpq5 \
    && rm -rf /var/lib/apt/lists/*

COPY --from=build-deps /install/ /usr/local/
COPY . .

RUN adduser --disabled-password --gecos '' appuser && chown -R appuser:appuser /app
USER appuser

ENV PLATFORM_MONITOR_WORKER=true
ENV PLATFORM_MONITOR_RUN_IN_API=false
ENV WEKA_J48_ENABLED=false
ENV WEKA_JVM_EAGER_START=false
ENV TWITCH_INSIGHTS_ENABLED=false

CMD ["python", "scripts/platform_monitor_worker.py"]
